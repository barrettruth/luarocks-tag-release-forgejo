{
  "runtime": {
    "version": "Lua 5.1",
    "path": ["lua/?.lua", "lua/?/init.lua"]
  },
  "diagnostics": {
    "globals": [
      "assert",
      "build",
      "dependencies",
      "describe",
      "it",
      "package",
      "rockspec_format",
      "source",
      "test_dependencies",
      "version",
      "vim"
    ],
    "disable": ["lowercase-global", "undefined-field"]
  },
  "workspace": {
    "library": ["${3rd}/busted/library", "${3rd}/luassert/library"],
    "checkThirdParty": false,
    "ignoreDir": [".direnv", ".git", "result"]
  },
  "completion": {
    "callSnippet": "Replace"
  }
}
